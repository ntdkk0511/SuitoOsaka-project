rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if signedInAs(uid)
        && request.resource.data.uid == uid
        && request.resource.data.score is number
        && request.resource.data.userPoints is number
        && request.resource.data.score >= 0
        && request.resource.data.userPoints >= 0
        && request.resource.data.score <= 100000
        && request.resource.data.userPoints <= 100000;
      allow update: if signedInAs(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['uid', 'nickname', 'score', 'userPoints', 'clearedSpots', 'obtainedCards', 'visitedLocations', 'lastUpdated'])
        && request.resource.data.score is number
        && request.resource.data.userPoints is number
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= resource.data.score + 200
        && request.resource.data.userPoints >= resource.data.userPoints - 1000
        && request.resource.data.userPoints >= 0
        && request.resource.data.userPoints <= resource.data.userPoints + 100
        && request.resource.data.clearedSpots.hasAll(resource.data.clearedSpots)
        && request.resource.data.clearedSpots.size() <= 100
        && request.resource.data.score <= 100000
        && request.resource.data.userPoints <= 100000;
      allow delete: if false;
    }
    match /buddies/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 1
        && request.resource.data.participants[0] == request.auth.uid
        && request.resource.data.members[request.auth.uid].uid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.participants.hasAny([request.auth.uid])
          || (request.resource.data.participants.hasAny([request.auth.uid])
            && request.resource.data.participants.size() <= 3))
        && request.resource.data.participants.size() <= 3;
      allow delete: if request.auth != null
        && resource.data.participants.hasAny([request.auth.uid]);
    }
  }
}
