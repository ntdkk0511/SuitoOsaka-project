}

.rank-number {
  width: 28px; font-weight: 700; font-size: 0.9rem; text-align: center;
  color: var(--text-brown-medium) !important;
}
.rank-nickname { flex: 1; font-size: 0.8rem; padding: 0 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-score { font-weight: 700; font-size: 0.85rem; }

/* 🥇🥈🥉 金銀銅の色分け */
.rank-1 .rank-number { color: var(--gold) !important; text-shadow: 0 0 6px rgba(255, 215, 0, 0.6); }
.rank-2 .rank-number { color: var(--silver) !important; text-shadow: 0 0 6px rgba(192, 192, 192, 0.6); }
.rank-3 .rank-number { color: var(--bronze) !important; text-shadow: 0 0 6px rgba(205, 127, 50, 0.6); }

.loading-text { font-size: 0.8rem; margin: 20px 0; color: var(--text-brown-medium) !important; }
.confirm-btn.holo-btn {
  background: linear-gradient(135deg, rgba(0, 30, 60, 0.95) 0%, rgba(0, 15, 35, 0.98) 100%);
  border: 1px solid var(--cyber-blue); box-shadow: 0 0 10px rgba(0, 191, 255, 0.3);
}

/* 📸 ARビューポート */
.ar-viewport-fullscreen { position: fixed; inset: 0; z-index: 5000; background: linear-gradient(rgba(0, 191, 255, 0.07) 1px, transparent 1px) 0 0 / 20px 20px, linear-gradient(90deg, rgba(0, 191, 255, 0.07) 1px, transparent 1px) 0 0 / 20px 20px, radial-gradient(circle at center, rgba(0, 40, 80, 0.85) 0%, rgba(0, 10, 25, 0.98) 100%); display: flex; flex-direction: column; justify-content: space-between; padding: 24px 20px 40px; overflow: hidden; }
.ar-flash-overlay { position: absolute; inset: 0; background: #ffffff; opacity: 0; pointer-events: none; z-index: 100; }
.ar-flash-overlay.active { animation: flashTrigger 0.2s ease-out forwards; }
@keyframes flashTrigger { 0% { opacity: 1; } 100% { opacity: 0; } }
.ar-scan-line { position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(to right, transparent, var(--cyber-blue), transparent); opacity: 0.6; animation: arScan 4s linear infinite; pointer-events: none; }
@keyframes arScan { 0% { top: 0%; } 100% { top: 100%; } }
.ar-frame-corners { position: absolute; inset: 30px; border: 2px solid rgba(0, 191, 255, 0.2); pointer-events: none; }
.ar-top-overlay { display: flex; justify-content: space-between; align-items: center; background: rgba(0, 15, 30, 0.75); border: 1px solid rgba(0, 191, 255, 0.3); padding: 12px 16px; border-radius: 10px; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
.ar-spot-title { font-size: 0.95rem; font-weight: 700; color: var(--cyber-blue) !important; }
.ar-status-pill { font-size: 0.65rem; font-weight: 700; background: rgba(0, 230, 118, 0.2); padding: 3px 8px; border-radius: 20px; border: 1px solid #00e676; color: #00e676 !important; }
.ar-hologram-center { position: absolute; top: 45%; left: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; pointer-events: none; }
.hologram-ring { width: 140px; height: 40px; border: 2px dashed var(--cyber-blue); border-radius: 50%; animation: rotateRing 8s linear infinite; opacity: 0.5; box-shadow: 0 0 15px rgba(0, 191, 255, 0.3); }
@keyframes rotateRing { 100% { transform: rotate(360deg); } }
.hologram-monument { position: absolute; top: -40px; display: flex; flex-direction: column; align-items: center; animation: floatHolo 3s ease-in-out infinite; }
@keyframes floatHolo { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
.hologram-icon { font-size: 3rem; filter: drop-shadow(0 0 10px rgba(0, 191, 255, 0.8)); }
.hologram-text { font-size: 0.75rem; font-weight: 700; letter-spacing: 2px; margin: 10px 0 2px; background: rgba(0,0,0,0.4); padding: 2px 8px; border-radius: 4px; color: var(--cyber-blue) !important; text-shadow: 0 0 8px var(--cyber-blue); }
.hologram-year { font-size: 0.6rem; font-weight: bold; color: #ffffff !important; opacity: 0.8; }
.ar-bottom-controls { position: relative; display: flex; justify-content: space-between; align-items: center; z-index: 10; }
.ar-btn-close { background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.3); padding: 10px 16px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; cursor: pointer; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); color: #fff !important; }
.ar-shutter-outer { width: 72px; height: 72px; border: 4px solid #ffffff; border-radius: 50%; display: flex; justify-content: center; align-items: center; box-shadow: 0 0 15px rgba(0,0,0,0.3); cursor: pointer; }
.ar-shutter-inner { width: 56px; height: 56px; background: #ffffff; border-radius: 50%; border: none; cursor: pointer; transition: transform 0.1s; }
.ar-shutter-inner:active { transform: scale(0.9); background: var(--cyber-blue); }
.ar-success-overlay { position: absolute; inset: 0; background: rgba(0, 10, 25, 0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); display: flex; justify-content: center; align-items: center; z-index: 200; }
.ar-success-modal { background: linear-gradient(185deg, rgba(0, 30, 60, 0.95) 0%, rgba(0, 15, 35, 0.98) 100%); border: 2px solid var(--cyber-blue); box-shadow: 0 0 30px rgba(0, 191, 255, 0.3); padding: 24px 20px; border-radius: 16px; width: 85%; max-width: 300px; text-align: center; animation: modalPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.1) forwards; }
.holo-badge { font-size: 0.65rem; font-weight: 700; color: #00e676 !important; border: 1px solid #00e676; padding: 2px 10px; border-radius: 4px; background: rgba(0, 230, 118, 0.1); display: inline-block; margin-bottom: 12px; }
.ar-success-modal h2 { margin: 0 0 10px; font-size: 1.25rem; font-weight: 700; color: #ffffff !important; }
.holo-reward-desc { font-size: 0.8rem; line-height: 1.5; color: rgba(255,255,255,0.7) !important; margin: 0 0 16px; text-align: left; }
.holo-score-up { font-size: 2rem; font-weight: 700; color: var(--cyber-blue) !important; text-shadow: 0 0 12px var(--cyber-blue); margin-bottom: 20px; }
.holo-close-btn { background: var(--cyber-blue); border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer; width: 100%; box-shadow: 0 0 15px rgba(0, 191, 255, 0.4); color: #ffffff !important; }
.holo-close-btn:active { transform: scale(0.98); opacity: 0.9; }
