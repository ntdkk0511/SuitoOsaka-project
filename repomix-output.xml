/* 1. Google Fonts から Inter を確実にダウンロード */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');

/* 2. 半角数字（0〜9）だけに適用する Inter フォントを定義 */
@font-face {
  font-family: 'SimpleNumberFont';
  src: url('https://fonts.gstatic.com/s/inter/v18/UcAvPiAZNYlWzpUeaB32.woff2') format('woff2');
  unicode-range: U+0030-0039; /* '0' から '9' までの数字のみ指定 */
}

/* 3. 数字だけ Inter を最優先にし、文字は元のフォントにフォールバックさせる */
html, body, div, span, p, a, button, input, select, textarea, h1, h2, h3, h4, h5, h6 {
  font-family: 'SimpleNumberFont', Georgia, "Times New Roman", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Sans", "Meiryo", serif !important;
}

.counter {
  font-size: 16px;
  padding: 5px 10px;
  border-radius: 5px;
  color: var(--accent);
  background: var(--accent-bg);
  border: 2px solid transparent;
  transition: border-color 0.3s;
  margin-bottom: 24px;

  &:hover {
    border-color: var(--accent-border);
  }
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
}

.hero {
  position: relative;

  .base,
  .framework,
  .vite {
    inset-inline: 0;
    margin: 0 auto;
  }

  .base {
    width: 170px;
    position: relative;
    z-index: 0;
  }

  .framework,
  .vite {
    position: absolute;
  }

  .framework {
    z-index: 1;
    top: 34px;
    height: 28px;
    transform: perspective(2000px) rotateZ(300deg) rotateX(44deg) rotateY(39deg)
      scale(1.4);
  }

  .vite {
    z-index: 0;
    top: 107px;
    height: 26px;
    width: auto;
    transform: perspective(2000px) rotateZ(300deg) rotateX(40deg) rotateY(39deg)
      scale(0.8);
  }
}

#center {
  display: flex;
  flex-direction: column;
  gap: 25px;
  place-content: center;
  place-items: center;
  flex-grow: 1;

  @media (max-width: 1024px) {
    padding: 32px 20px 24px;
    gap: 18px;
  }
}

#next-steps {
  display: flex;
  border-top: 1px solid var(--border);
  text-align: left;

  & > div {
    flex: 1 1 0;
    padding: 32px;
    @media (max-width: 1024px) {
      padding: 24px 20px;
    }
  }

  .icon {
    margin-bottom: 16px;
    width: 22px;
    height: 22px;
  }

  @media (max-width: 1024px) {
    flex-direction: column;
    text-align: center;
  }
}

#docs {
  border-right: 1px solid var(--border);

  @media (max-width: 1024px) {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
}

#next-steps ul {
  list-style: none;
  padding: 0;
  display: flex;
  gap: 8px;
  margin: 32px 0 0;

  .logo {
    height: 18px;
  }

  a {
    color: var(--text-h);
    font-size: 16px;
    border-radius: 6px;
    background: var(--social-bg);
    display: flex;
    padding: 6px 12px;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: box-shadow 0.3s;

    &:hover {
      box-shadow: var(--shadow);
    }
    .button-icon {
      height: 18px;
      width: 18px;
    }
  }

  @media (max-width: 1024px) {
    margin-top: 20px;
    flex-wrap: wrap;
    justify-content: center;

    li {
      flex: 1 1 calc(50% - 8px);
    }

    a {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
  }
}

#spacer {
  height: 88px;
  border-top: 1px solid var(--border);
  @media (max-width: 1024px) {
    height: 48px;
  }
}

.ticks {
  position: relative;
  width: 100%;

  &::before,
  &::after {
    content: '';
    position: absolute;
    top: -4.5px;
    border: 5px solid transparent;
  }

  &::before {
    left: 0;
    border-left-color: var(--border);
  }
  &::after {
    right: 0;
    border-right-color: var(--border);
  }
}

/* マップステージ */
.map-stage-aquatic { position: absolute; inset: 0; z-index: 1; }
.mapbox-container { width: 100%; height: 100%; position: absolute; inset: 0;}

/* 霧オーバーレイ（地図キャンバスの上、マーカーの下） */
.map-fog-overlay { 
  position: absolute; 
  inset: 0; 
  z-index: 1; 
  pointer-events: none; 
  background: rgba(255, 255, 255, 0.45); 
  backdrop-filter: grayscale(100%) brightness(1.02) blur(5px); 
  -webkit-backdrop-filter: grayscale(100%) brightness(1.02) blur(5px); 
  mask-size: cover; 
  -webkit-mask-size: cover; 
}

/* スポットアイコン＆現在地マーカー（常に霧の上） */
.mapboxgl-marker { 
  z-index: 10 !important; 
}
