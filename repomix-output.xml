}
.ripple-container { position: relative; width: 100px; height: 100px; display: flex; justify-content: center; align-items: center; }
.water-drop { width: 12px; height: 12px; background: #0288d1; border-radius: 50% 0 50% 50%; transform: rotate(-45deg); animation: splashDrop 1s ease-in forwards; }
.wave-ripple { position: absolute; border: 2px solid rgba(2, 136, 209, 0.2); border-radius: 50%; opacity: 0; animation: splashRipple 1.8s cubic-bezier(0.1, 0.8, 0.3, 1) infinite; }
@keyframes splashDrop { 0% { transform: translateY(-100px) rotate(-45deg); opacity: 0; } 60% { transform: translateY(0) rotate(-45deg); opacity: 1; } 100% { transform: translateY(0) scale(1.4) rotate(-45deg); opacity: 0; } }
@keyframes splashRipple { 0% { width: 0; height: 0; opacity: 1; } 100% { width: 160px; height: 160px; opacity: 0; } }
.splash-logo-zone { text-align: center; margin-top: 16px; }
.splash-eyebrow * { color: var(--text-brown-medium) !important; font-weight: 400; }
.splash-eyebrow { font-size: 0.7rem; letter-spacing: 4px; margin: 0; }
.splash-title { margin: 6px 0; font-size: 1.7rem; font-weight: 700; letter-spacing: -1px; }

/* ヘッダー */
.aquatic-header-minimal {
  position: absolute; top: 12px; left: 12px; right: 12px; z-index: 100;
  display: flex; justify-content: space-between; align-items: center;
  background: var(--glass-bg); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  padding: 8px 14px; border-radius: 12px; border: 1px solid var(--glass-border);
  box-shadow: 0 4px 12px rgba(62,39,35,0.05);
}
.header-logo { font-size: 0.85rem; font-weight: 700; }
.header-player-zone { display: flex; align-items: center; gap: 8px; }

/* 🏆 【Step 2】ランキングを開くアイコンボタン */
.header-rank-btn {
  background: none; border: none; font-size: 1.2rem; cursor: pointer; padding: 4px;
  transition: transform 0.2s;
}
.header-rank-btn:hover { transform: scale(1.1); }

.header-player-profile { display: flex; align-items: center; gap: 10px; background: rgba(62, 39, 35, 0.05); padding: 4px 10px; border-radius: 20px; cursor: pointer; transition: background 0.2s; }
.header-player-profile:hover { background: rgba(62, 39, 35, 0.09); }
.header-nickname { font-size: 0.75rem; font-weight: 700; max-width: 90px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.header-score { font-size: 0.75rem; font-weight: 700; border-left: 1px solid rgba(62, 39, 35, 0.2); padding-left: 10px; }

/* マップステージ */
.map-stage-aquatic { position: absolute; inset: 0; z-index: 1; }
.mapbox-container { width: 100%; height: 100%; position: absolute; inset: 0;}
.map-fog-overlay { position: absolute; inset: 0; z-index: 5; pointer-events: none; background: rgba(255, 255, 255, 0.45); backdrop-filter: grayscale(100%) brightness(1.02) blur(5px); -webkit-backdrop-filter: grayscale(100%) brightness(1.02) blur(5px); mask-size: cover; -webkit-mask-size: cover; }
.mapboxgl-marker,.map-native-marker { z-index: 10 !important; }

/* カスタムマーカー */
.map-native-marker {
  position: absolute !important;
  cursor: pointer;
  /* 最外枠の display: flex は Mapbox の位置計算を破壊するため除去 */
}

.marker-core-circle {
  position: relative;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 3px solid #ffffff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.35);
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  margin: 0 auto; /* 円を中央に配置 */
}

.cleared .marker-core-circle {
  background-color: var(--cyber-blue);
  box-shadow: 0 0 14px var(--cyber-blue), 0 2px 8px rgba(0,0,0,0.3);
}

.locked .marker-core-circle {
  background-color: #5a6370;
}

.locked .marker-pulse-ring {
  position: absolute;
  top: -6px;
  left: -6px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2px solid rgba(90, 99, 112, 0.6);
  animation: pulseWave 2s cubic-bezier(0.25, 0, 0, 1) infinite;
  pointer-events: none;
}

@keyframes pulseWave {
  0% { transform: scale(0.6); opacity: 1; }
  100% { transform: scale(2.2); opacity: 0; border-color: rgba(0, 191, 255, 0.1); }
}

.map-native-marker.active .marker-core-circle {
  transform: scale(1.35);
  border-color: #ffffff;
  box-shadow: 0 0 20px var(--cyber-blue), 0 4px 12px rgba(0,0,0,0.4);
}

.marker-core-label {
  position: relative;
  left: 50%;
  transform: translateX(-50%); /* ラベルの左右中央揃え */
  margin-top: 6px;
  font-size: 11px;
  font-weight: bold;
  color: #222222;
  background: rgba(255, 255, 255, 0.95);
  padding: 3px 8px;
  border-radius: 10px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  white-space: nowrap;
  user-select: none;
  transition: all 0.2s ease;
  display: table; /* 横幅自動調整 */
}

.map-native-marker.active .marker-core-label {
  background: #3E2723;
  color: #ffffff;
  transform: translateX(-50%) translateY(2px);
}
/* 📱 一体型ボトムドック */
.integrated-bottom-dock { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(225,245,254,0.98) 85%, rgba(255,255,255,0.85) 100%); border-top: 1px solid var(--glass-border); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); padding: 16px 16px 28px; display: flex; flex-direction: column; gap: 16px; z-index: 110; box-shadow: 0 -10px 30px rgba(62, 39, 35, 0.05); }
.embedded-story-card { background: rgba(255,255,255,0.4); padding: 14px 16px; border-radius: 14px; border: 1px solid rgba(62, 39, 35, 0.06); }
