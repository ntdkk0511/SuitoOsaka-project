<file path="src/hooks/useFogOverlay.js">
import { useEffect } from 'react';
import { SPOTS_DATA } from '../constants/spots';

/**
 * 緯度経度と指定メートル数から、現在の地図ズームに応じた画面上のピクセル半径を算出
 */
const getPixelRadiusFromMeters = (map, lngLat, meters) => {
  const centerPixel = map.project(lngLat);
  const lat = lngLat[1];
  // 該当緯度における経度1度あたりの距離(m)から、指定m分移動したピクセル位置を計算
  const deltaLng = meters / (111320 * Math.cos((lat * Math.PI) / 180));
  const edgePixel = map.project([lngLat[0] + deltaLng, lat]);

  const dx = edgePixel.x - centerPixel.x;
  const dy = edgePixel.y - centerPixel.y;
  return Math.sqrt(dx * dx + dy * dy);
};

export function useFogOverlay({
  mapRef,
  fogOverlayRef,
  clearedSpots,
  visitedLocations,
  userLocation,
  fogRadiiRef
}) {
  const updateFogPosition = () => {
    if (!mapRef.current || !fogOverlayRef.current) return;
    const map = mapRef.current;

    // 1. クリア済みスポット（メートル単位：既定80m）
    const clearedSpotsData = SPOTS_DATA
      .filter(spot => clearedSpots.includes(spot.id))
      .map(spot => ({
        lngLat: spot.lngLat,
        radiusMeters: fogRadiiRef.current[spot.id] ?? 80
      }));

    // 2. 歩いた軌跡 ＆ 3. 現在地（メートル単位：25m）
    const pathPoints = [
      ...visitedLocations,
      ...(userLocation ? [userLocation] : [])
    ].map(lngLat => ({
      lngLat,
      radiusMeters: 25 // 🚶 歩行で晴れる実際の半径（25メートル）
    }));

    const allRevealPoints = [...clearedSpotsData, ...pathPoints];
    if (allRevealPoints.length === 0) return;

    const gradients = allRevealPoints.map(item => {
      const pixelPos = map.project(item.lngLat);
      if (pixelPos && typeof pixelPos.x === 'number' && typeof pixelPos.y === 'number') {
        // メートル単位から画面上のピクセル半径に動的変換
        const radiusPx = getPixelRadiusFromMeters(map, item.lngLat, item.radiusMeters);
        
        // 画面外や極小サイズ時のケア
        if (radiusPx < 0.5) return null;

        return `radial-gradient(circle ${radiusPx}px at ${pixelPos.x}px ${pixelPos.y}px, transparent 20%, black 85%)`;
      }
      return null;
    }).filter(Boolean);

    if (gradients.length === 0) return;
    const maskStyle = gradients.join(', ');

    requestAnimationFrame(() => {
      if (!fogOverlayRef.current) return;
      fogOverlayRef.current.style.webkitMaskImage = maskStyle;
      fogOverlayRef.current.style.maskImage = maskStyle;
      fogOverlayRef.current.style.webkitMaskComposite = 'source-over';
      fogOverlayRef.current.style.maskComposite = 'intersect';
    });
  };

  useEffect(() => {
    if (!mapRef.current) return;
    const map = mapRef.current;

    map.off('move', updateFogPosition);
    map.on('move', updateFogPosition);
    updateFogPosition();

    return () => {
      map.off('move', updateFogPosition);
    };
  }, [clearedSpots, visitedLocations, userLocation]);

  return { updateFogPosition };
}
</file>

<file path="src/hooks/useGeolocation.js">
import { useState, useEffect } from 'react';

export const useGeolocation = () => {
  const [location, setLocation] = useState(null);
  const [error, setError] = useState(null);

  useEffect(() => {
    if (!navigator.geolocation) {
      setError('お使いのブラウザは位置情報をサポートしていません。');
      return;
    }

    const watchId = navigator.geolocation.watchPosition(
      (position) => {
        setLocation([position.coords.longitude, position.coords.latitude]);
        setError(null);
      },
      (err) => {
        setError(err.message);
      },
      {
        enableHighAccuracy: true, // GPS精度を最大化
        maximumAge: 0,
        timeout: 10000
      }
    );

    return () => navigator.geolocation.clearWatch(watchId);
  }, []);

  return { location, error };
};
</file>

<file path="src/hooks/useStepCounter.js">
import { useState, useEffect, useRef } from 'react';

export function useStepCounter(userLocation) {
  const [steps, setSteps] = useState(() => {
    const savedDate = localStorage.getItem('tw_step_date');
    const today = new Date().toDateString();
    if (savedDate !== today) {
      localStorage.setItem('tw_step_date', today);
      localStorage.setItem('tw_today_steps', '0');
      return 0;
    }
    return parseInt(localStorage.getItem('tw_today_steps') || '0', 10);
  });

  const lastLocationRef = useRef(null);
  const lastAccelRef = useRef({ x: 0, y: 0, z: 0 });

  // 歩数の保存
  useEffect(() => {
    localStorage.setItem('tw_today_steps', steps.toString());
  }, [steps]);

  // 1. 加速度センサー（DeviceMotion）による歩数カウント
  useEffect(() => {
    let lastStepTime = 0;

    const handleMotion = (event) => {
      const acc = event.accelerationIncludingGravity;
      if (!acc) return;

      const deltaX = acc.x - lastAccelRef.current.x;
      const deltaY = acc.y - lastAccelRef.current.y;
      const deltaZ = acc.z - lastAccelRef.current.z;
      const acceleration = Math.sqrt(deltaX * deltaX + deltaY * deltaY + deltaZ * deltaZ);

      lastAccelRef.current = { x: acc.x, y: acc.y, z: acc.z };

      // 閾値を超えた運動を歩行として認識 (1秒間に最大2〜3歩程度に抑える)
      const now = Date.now();
      if (acceleration > 11 && now - lastStepTime > 350) {
        lastStepTime = now;
        setSteps((prev) => Math.min(prev + 1, 10000)); // 上限10,000歩
      }
    };

    if (window.DeviceMotionEvent) {
      window.addEventListener('devicemotion', handleMotion);
    }

    return () => {
      if (window.DeviceMotionEvent) {
        window.removeEventListener('devicemotion', handleMotion);
      }
    };
  }, []);

  // 2. 位置情報（GPS移動距離）からの歩数推計（センサー非対応時のバックアップ）
  useEffect(() => {
    if (!userLocation) return;

    if (lastLocationRef.current) {
      const [lng1, lat1] = lastLocationRef.current;
      const [lng2, lat2] = userLocation;

      // ハーバーサイン公式による2点間距離(m)算出
      const R = 6371000;
      const dLat = ((lat2 - lat1) * Math.PI) / 180;
      const dLng = ((lng2 - lng1) * Math.PI) / 180;
      const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos((lat1 * Math.PI) / 180) *
          Math.cos((lat2 * Math.PI) / 180) *
          Math.sin(dLng / 2) *
          Math.sin(dLng / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      const distance = R * c;

      // 3m以上100m未満の正常な徒歩移動の場合に歩数算定（歩幅約0.7m換算）
      if (distance >= 3 && distance < 100) {
        const addedSteps = Math.round(distance / 0.7);
        setSteps((prev) => Math.min(prev + addedSteps, 10000));
      }
    }

    lastLocationRef.current = userLocation;
  }, [userLocation]);

  return { steps, setSteps };
}
</file>

<file path="src/hooks/useVisitedLocations.js">
import { useState, useEffect } from 'react';
import { isWithinRadius } from '../utils/geo';

/**
 * GPS現在地を監視し、10m移動するごとに歩行軌跡（visitedLocations）を記録・保存するフック
 */
export function useVisitedLocations(userLocation) {
  const [visitedLocations, setVisitedLocations] = useState(() => {
    return JSON.parse(localStorage.getItem('tw_visited_locations') || '[]');
  });

  // LocalStorageに自動保存
  useEffect(() => {
    localStorage.setItem('tw_visited_locations', JSON.stringify(visitedLocations));
  }, [visitedLocations]);

  // 10m移動するごとに軌跡を追加
  useEffect(() => {
    if (!userLocation) return;

    setVisitedLocations(prev => {
      if (prev.length === 0) return [userLocation];
      const lastLoc = prev[prev.length - 1];
      const { isNear } = isWithinRadius(userLocation, lastLoc, 10);
      if (!isNear) {
        return [...prev, userLocation];
      }
      return prev;
    });
  }, [userLocation]);

  return { visitedLocations };
}
</file>

